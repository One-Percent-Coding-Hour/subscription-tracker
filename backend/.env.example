# ================================
# 🌍 Environment Configuration
# ================================

# Set your environment: "development", "production", or "test"
NODE_ENV=development

# The port your server should run on
PORT=5000

# ================================
# 🗄️ Database Configuration
# ================================

# Your MongoDB connection string (example for MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database-name>

# ================================
# 🔐 Authentication Configuration
# ================================

# Secret key used to sign JWT tokens
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiration time (e.g., 1d, 7d, 1h)
JWT_EXPIRES_IN=7d